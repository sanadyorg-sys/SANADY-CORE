# ─── Supabase ──────────────────────────────────────────────────────────────
# Project URL and public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Application ───────────────────────────────────────────────────────────
# Public base URL, used in invitation e-mails and certificate QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── E-mail (Resend) ───────────────────────────────────────────────────────
# Optional in development: when empty, invitation links are shown to the
# administrator instead of being e-mailed (clearly flagged in the UI).
RESEND_API_KEY=
EMAIL_FROM="SANADY <no-reply@example.org>"

# ─── Video: Mux signed playback (optional, recommended in production) ─────
# Without these, videos are served from private Supabase Storage via
# short-lived signed URLs (progressive MP4, no adaptive bitrate).
MUX_SIGNING_KEY_ID=
# Base64-encoded RSA private key (PEM) from Mux → Settings → Signing keys.
MUX_SIGNING_PRIVATE_KEY=
