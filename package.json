{
  "name": "sanady-core",
  "version": "0.1.0",
  "private": true,
  "description": "SANADY — Plateforme de formation et de développement professionnel des enseignants",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:types": "npx supabase gen types typescript --linked > src/lib/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^10.5.0",
    "server-only": "^0.0.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "pdfjs-dist": "^5.4.296",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
